{
    "name": "@nehemiahdias/create-reactts-vite-tailwind",
    "description": "Modern React starter template with TypeScript, Vite, Tailwind CSS, and SCSS for rapid development.",
    "version": "2.0.0",
    "author": "Nitro",
    "bin": "./bin/cli.js",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "react",
        "typescript",
        "vite",
        "tailwind",
        "template",
        "starter",
        "boilerplate"
    ],
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/NehemiahDias/reactts-vite-tailwind"
    },
    "homepage": "https://github.com/NehemiahDias/reactts-vite-tailwind#readme",
    "bugs": {
        "url": "https://github.com/NehemiahDias/reactts-vite-tailwind/issues"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview",
        "prettier-check": "npx prettier . --check",
        "prettier": "npx prettier . --write",
        "type-check": "tsc --noEmit",
        "test": ""
    },
    "dependencies": {
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "react-router-dom": "^7.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^25.0.3",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.2",
        "autoprefixer": "^10.4.19",
        "eslint": "^9.39.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "postcss": "^8.4.39",
        "sass": "^1.77.7",
        "tailwindcss": "^3.4.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.52.0",
        "vite": "^6.4.1"
    }
}
